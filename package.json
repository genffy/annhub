{
  "name": "annhub",
  "version": "1.0.3",
  "description": "Browser extension that captures knowledge fragments with their context, for review in AnnHub Desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "store:assets": "npm run build && STORE_ASSETS=1 playwright test e2e/store-assets.spec.ts",
    "verify": "npm run format:check && npm run lint && npm run compile && npm test && npm run check:docs && npm run check:lockfiles && npm run check:consistency",
    "postinstall": "wxt prepare",
    "website:dev": "cd website && npm run dev",
    "website:build": "cd website && npm ci && npm run build",
    "website:start": "cd website && npm run start"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.4",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.18",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
