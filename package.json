{
  "name": "annhub",
  "version": "2.2.1",
  "description": "Browser extension that clips and screenshots web content with its source into one local library",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint --config eslint.config.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run compile && pnpm test && pnpm run check:docs && pnpm run check:size && pnpm run check:lockfiles && pnpm run check:consistency",
    "postinstall": "wxt prepare",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website install --frozen-lockfile && pnpm --dir website build",
    "website:start": "pnpm --dir website start",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.4",
    "defuddle": "^0.19.6",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
