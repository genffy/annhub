{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run verify)",
      "Bash(pnpm run compile)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run check:docs)",
      "Bash(pnpm run check:size)",
      "Bash(pnpm run check:consistency)",
      "Bash(pnpm run build)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm exec eslint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)"
    ],
    "deny": ["Read(./pnpm-lock.yaml)", "Read(./website/pnpm-lock.yaml)", "Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)", "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git reset --hard *)", "Bash(rm -rf /*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated-files.mjs"
          }
        ]
      }
    ]
  }
}
