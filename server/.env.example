# Copy to .env and adjust. All values optional — defaults run a local dev server.

# SQLite path (":memory:" = in-process, useful for tests).
ANNHUB_DB_PATH=data/annhub_memory.db

# Max events accepted per POST /v1/memory/events batch (design §3.1 cap = 500).
ANNHUB_MAX_BATCH_SIZE=500

# Recall cache TTL advertised to clients (seconds).
ANNHUB_RECALL_TTL_SECONDS=86400

# Minimum labelled events before HLR training is attempted (cold-start guard).
ANNHUB_MIN_EVENTS_TO_TRAIN=20

# Auth: leave blank for anonymous-device mode (any non-empty bearer accepted).
# Set to a shared secret to require Authorization: Bearer <secret> on every call.
ANNHUB_AUTH_SHARED_SECRET=

# Bearer realm surfaced on 401 responses.
ANNHUB_AUTH_REALM=annhub-memory
