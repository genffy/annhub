{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["chrome"],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // An indexed read may be undefined: `list[0]`, `record[key]`, a regex group. WXT's base config sets it too.
    "noUncheckedIndexedAccess": true,
    // Aligned with the generated config, spelled out here so the root reads whole (RV-TEST-17):
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    // Messages cross JSON, where a `undefined` field vanishes: "clear" is `null`, and this option
    // keeps "no value" and "no field" distinct in the types as well (RV-TEST-17).
    "exactOptionalPropertyTypes": true
    /* shadcn/ui path mapping */
    // "baseUrl": ".",
  },
  "include": [
    "**/*",
    // naming include replaces the generated config's one, so its declarations come along explicitly
    ".wxt/wxt.d.ts",
    // the default wildcard does not enter dot directories; the store-shot scripts import e2e/fixtures
    // and e2e/helpers, so a helper that changes shape must fail here, not at the next store release (RV-TEST-13)
    ".agents/skills/store-submission/shots/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "website",
    // only holds each release's finished assets and their archives (git-ignored, never committed);
    // without this a checkout that has it type-checks archive copies of old configs (RV-TEST-13)
    "store-assets"
  ]
}
